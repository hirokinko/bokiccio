package webui

import (
	"github.com/hirokinko/bokiccio/internal/reporting"
	"github.com/hirokinko/bokiccio/internal/webapp"
)

templ documentHead(title string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title } · Bokiccio</title>
		<link rel="stylesheet" href="/assets/app.css"/>
		<script src="/assets/htmx-2.0.10.min.js" defer></script>
		<script src="/assets/app.js" defer></script>
	</head>
}

templ siteHeader(page pageContext) {
	<header class="site-header">
		<div class="site-title">
			<a class="brand" href={ page.HomeHref }>Bokiccio</a>
			<span>{ page.Messages.SiteTagline }</span>
		</div>
		<div class="site-navigation">
			<nav class="primary-navigation">
				<a href={ page.HomeHref }>{ page.Messages.NavigationEntries }</a>
				<a href={ page.SettingsHref }>{ page.Messages.NavigationSettings }</a>
				<a href={ page.ReportsHref }>{ page.Messages.NavigationReports }</a>
			</nav>
			<nav class="language-switcher" aria-label={ page.Messages.LanguageLabel }>
				<span>{ page.CurrentLocale }</span>
				<a href={ page.JapaneseHref }>{ page.Messages.JapaneseLanguage }</a>
				<a href={ page.EnglishHref }>{ page.Messages.EnglishLanguage }</a>
			</nav>
		</div>
	</header>
}

templ indexPage(model indexPageModel) {
	<!DOCTYPE html>
	<html lang={ model.Page.Locale.lang() }>
		@documentHead(model.Page.Messages.IndexTitle)
		<body>
			@siteHeader(model.Page)
			<main id="main-content" class="page">
				<header class="page-heading">
					<div>
						<p class="eyebrow">{ model.Page.Messages.IndexEyebrow }</p>
						<h1>{ model.Page.Messages.IndexTitle }</h1>
					</div>
				</header>
				@uploadForm(model)
				@searchForm(model)
				@entryResults(model)
			</main>
		</body>
	</html>
}

templ uploadForm(model indexPageModel) {
	<form class="upload-panel" method="post" action={ model.Upload.Action } enctype="multipart/form-data" aria-label={ model.Page.Messages.UploadFormLabel }>
		<div>
			<h2>{ model.Page.Messages.UploadHeading }</h2>
			<p>{ model.Page.Messages.UploadHelp }</p>
		</div>
		<label>{ model.Page.Messages.UploadFileLabel }<input type="file" name="file" accept="application/json,.json" required/></label>
		<button type="submit">{ model.Page.Messages.UploadSubmit }</button>
	</form>
	<form class="upload-panel" method="post" action={ model.TacklerUpload.Action } enctype="multipart/form-data" aria-label={ model.Page.Messages.TacklerUploadFormLabel }>
		<div>
			<h2>{ model.Page.Messages.TacklerUploadHeading }</h2>
			<p>{ model.Page.Messages.TacklerUploadHelp }</p>
		</div>
		<label>{ model.Page.Messages.TacklerUploadFileLabel }<input type="file" name="file" accept="text/plain,.txn" required/></label>
		<button type="submit">{ model.Page.Messages.TacklerUploadSubmit }</button>
	</form>
}

templ reportingSettingsPage(model reportingSettingsPageModel) {
	<!DOCTYPE html>
	<html lang={ model.Page.Locale.lang() }>
		@documentHead(model.Page.Messages.ReportingSettingsTitle)
		<body>
			@siteHeader(model.Page)
			<main id="main-content" class="page detail-page reporting-settings-page">
				<header class="page-heading"><div><p class="eyebrow">{ model.Page.Messages.ReportingSettingsEyebrow }</p><h1>{ model.Page.Messages.ReportingSettingsTitle }</h1></div></header>
				<p>{ model.Page.Messages.ReportingSettingsIntro }</p>
				if !model.Configured {
					<section class="empty-state"><p>{ model.Page.Messages.ReportingNotConfigured }</p></section>
				} else {
					<p>{ model.Page.Messages.ReportingRevisionLabel }: { model.Form.BaseRevision }</p>
				}
				if model.FormError != "" {
					<section class="form-error" role="alert"><h2>{ model.Page.Messages.FormErrorTitle }</h2><p>{ model.FormError }</p></section>
				}
				<form class="reporting-form" method="post" action={ model.Form.Action }>
					<input type="hidden" name="base_revision" value={ formInt(model.Form.BaseRevision) }/>
					<section aria-labelledby="calendar-heading">
						<h2 id="calendar-heading">{ model.Page.Messages.ReportingCalendarHeading }</h2>
						<label class="stacked-field">{ model.Page.Messages.ReportingStartMonthLabel }<input type="number" name="start_month" min="1" max="12" value={ formInt(model.Form.StartMonth) } required/></label>
						<p class="warning-note">{ model.Page.Messages.ReportingCalendarWarning }</p>
					</section>
					<section aria-labelledby="classification-heading">
						<h2 id="classification-heading">{ model.Page.Messages.ReportingClassifications }</h2>
						<p>{ model.Page.Messages.ReportingClassificationHelp }</p>
						<input type="hidden" name="classification_account" value=""/>
						<input type="hidden" name="classification_category" value="asset"/>
						<div id="classification-rows" class="configuration-rows">
							for _, classification := range model.Form.Classifications {
								@reportingClassificationRow(model.Page.Messages, classification)
							}
						</div>
						<button type="button" class="secondary-button add-row-button" data-add-row="classification-row-template" data-row-target="classification-rows">{ model.Page.Messages.ReportingAddClassification }</button>
						<template id="classification-row-template">@reportingClassificationRow(model.Page.Messages, webapp.ReportingClassification{Category: reporting.CategoryAsset})</template>
					</section>
					<section aria-labelledby="fiscal-years-heading">
						<h2 id="fiscal-years-heading">{ model.Page.Messages.ReportingFiscalYears }</h2>
						<p>{ model.Page.Messages.ReportingFiscalYearHelp }</p>
						<input type="hidden" name="fiscal_start_date" value=""/>
						<input type="hidden" name="fiscal_end_date" value=""/>
						<input type="hidden" name="opening_mode" value="automatic"/>
						<input type="hidden" name="opening_entry_ids" value=""/>
						<div id="fiscal-year-rows" class="configuration-rows">
							for _, year := range model.Form.FiscalYears {
								@reportingFiscalYearRow(model.Page.Messages, year)
							}
						</div>
						<button type="button" class="secondary-button add-row-button" data-add-row="fiscal-year-row-template" data-row-target="fiscal-year-rows">{ model.Page.Messages.ReportingAddFiscalYear }</button>
						<template id="fiscal-year-row-template">@reportingFiscalYearRow(model.Page.Messages, reportingFiscalYearFormModel{OpeningMode: reporting.OpeningAutomatic})</template>
					</section>
					<div class="form-actions"><button type="submit">{ model.Page.Messages.ReportingSave }</button></div>
				</form>
				<section aria-labelledby="unclassified-heading">
					<h2 id="unclassified-heading">{ model.Page.Messages.ReportingUnclassifiedHeading }</h2>
					if len(model.UnclassifiedAccounts) == 0 {
						<p>{ model.Page.Messages.ReportingUnclassifiedNone }</p>
					} else {
						<ul>
							for _, account := range model.UnclassifiedAccounts {
								<li>{ account }</li>
							}
						</ul>
					}
				</section>
			</main>
		</body>
	</html>
}

templ reportingClassificationRow(msg messages, classification webapp.ReportingClassification) {
	<div class="configuration-row classification-row" data-configuration-row>
		<label>{ msg.AccountColumn }<input name="classification_account" value={ classification.Account }/></label>
		<label>{ msg.ReportingCategoryLabel }<select name="classification_category">
			for _, option := range reportingCategoryOptions(msg) {
				if classification.Category == option.Value {
					<option value={ string(option.Value) } selected>{ option.Label }</option>
				} else {
					<option value={ string(option.Value) }>{ option.Label }</option>
				}
			}
		</select></label>
		<button type="button" class="remove-row-button" data-remove-row>{ msg.ReportingRemoveClassification }</button>
	</div>
}

templ reportingFiscalYearRow(msg messages, year reportingFiscalYearFormModel) {
	<fieldset class="configuration-row fiscal-year-row" data-configuration-row>
		<label>{ msg.ReportingStartDateLabel }<input type="date" name="fiscal_start_date" value={ year.StartDate }/></label>
		<label>{ msg.ReportingEndDateLabel }<input type="date" name="fiscal_end_date" value={ year.EndDate }/></label>
		<label>{ msg.ReportingOpeningModeLabel }<select name="opening_mode">
			if year.OpeningMode == reporting.OpeningEntries {
				<option value="automatic">{ msg.ReportingOpeningAutomatic }</option>
				<option value="opening_entries" selected>{ msg.ReportingOpeningEntries }</option>
			} else {
				<option value="automatic" selected>{ msg.ReportingOpeningAutomatic }</option>
				<option value="opening_entries">{ msg.ReportingOpeningEntries }</option>
			}
		</select></label>
		<label class="opening-entry-field">{ msg.ReportingOpeningEntryIDs }<textarea name="opening_entry_ids" rows="3">{ year.OpeningEntryIDs }</textarea><span class="field-help">{ msg.ReportingOpeningEntryIDsHelp }</span></label>
		<button type="button" class="remove-row-button" data-remove-row>{ msg.ReportingRemoveFiscalYear }</button>
	</fieldset>
}

templ trialBalancePage(model trialBalancePageModel) {
	<!DOCTYPE html>
	<html lang={ model.Page.Locale.lang() }>
		@documentHead(model.Page.Messages.TrialBalanceTitle)
		<body>
			@siteHeader(model.Page)
			<main id="main-content" class="page detail-page trial-balance-page">
				@reportNavigation(model.Page)
				<header class="page-heading"><div><p class="eyebrow">{ model.Page.Messages.TrialBalanceEyebrow }</p><h1>{ model.Page.Messages.TrialBalanceTitle }</h1></div></header>
				if !model.Configured {
					<section class="empty-state"><p>{ model.Page.Messages.TrialBalanceNotConfigured }</p><a href={ model.SetupHref }>{ model.Page.Messages.TrialBalanceSetupLink }</a></section>
				} else {
					if model.FormError != "" {
						<section class="form-error" role="alert"><h2>{ model.Page.Messages.FormErrorTitle }</h2><p>{ model.FormError }</p></section>
					}
					<form class="period-form" method="post" action={ model.FormAction }>
						<label>{ model.Page.Messages.TrialBalancePeriodLabel }<select name="period">
							for _, option := range model.Periods {
								if option.Period == model.Selected {
									<option value={ option.Period.StartDate + "/" + option.Period.EndDate } selected>{ option.Label }</option>
								} else {
									<option value={ option.Period.StartDate + "/" + option.Period.EndDate }>{ option.Label }</option>
								}
							}
						</select></label>
						<button type="submit">{ model.Page.Messages.TrialBalanceShow }</button>
					</form>
					if model.Report != nil {
						<p>{ model.Page.Messages.TrialBalanceConfigurationRevision }: { model.Report.ConfigurationRevision } · { model.Report.Period.StartDate } – { model.Report.Period.EndDate }</p>
						if !model.Report.ClassificationComplete {
							<section class="form-error" role="alert"><p>{ model.Page.Messages.TrialBalanceClassificationWarning } <a href={ model.SetupHref }>{ model.Page.Messages.TrialBalanceSetupLink }</a></p></section>
						}
						if len(model.Report.Commodities) == 0 {
							<section class="empty-state"><p>{ model.Page.Messages.TrialBalanceEmpty }</p></section>
						} else {
							for _, commodity := range model.Report.Commodities {
								@trialBalanceCommodity(model.Page.Messages, commodity)
							}
						}
					}
				}
			</main>
		</body>
	</html>
}

templ reportNavigation(page pageContext) {
	<nav class="report-navigation" aria-label={ page.Messages.ReportNavigationLabel }>
		<a href={ currentOverviewHref(page.Locale) }>{ page.Messages.ReportNavigationCurrent }</a>
		<a href={ trialBalanceHref(page.Locale) }>{ page.Messages.ReportNavigationTrialBalance }</a>
		<a href={ balanceSheetHref(page.Locale) }>{ page.Messages.ReportNavigationBalanceSheet }</a>
		<a href={ incomeStatementHref(page.Locale) }>{ page.Messages.ReportNavigationIncomeStatement }</a>
		<a href={ balanceTrendHref(page.Locale) }>{ page.Messages.ReportNavigationBalanceTrend }</a>
	</nav>
}

templ currentOverviewPage(model currentOverviewPageModel) {
	<!DOCTYPE html>
	<html lang={ model.Page.Locale.lang() }>
		@documentHead(model.Page.Messages.CurrentOverviewTitle)
		<body>
			@siteHeader(model.Page)
			<main id="main-content" class="page detail-page current-overview-page">
				@reportNavigation(model.Page)
				<header class="page-heading"><div><p class="eyebrow">{ model.Page.Messages.CurrentOverviewEyebrow }</p><h1>{ model.Page.Messages.CurrentOverviewTitle }</h1></div></header>
				<p>{ model.Page.Messages.CurrentOverviewIntro }</p>
				if !model.Configured {
					<section class="empty-state"><p>{ model.Page.Messages.StatementNotConfigured }</p><a href={ model.SetupHref }>{ model.Page.Messages.StatementSetupLink }</a></section>
				} else {
					if model.FormError != "" {
						<section class="form-error" role="alert"><h2>{ model.Page.Messages.FormErrorTitle }</h2><p>{ model.FormError }</p></section>
					}
					if model.Report != nil {
						<p>{ model.Page.Messages.StatementConfigurationRevision }: { model.Report.ConfigurationRevision } · { model.Page.Messages.CurrentOverviewAsOf }: { model.Report.AsOf } · { model.Page.Messages.CurrentOverviewFiscalYear }: { model.Report.FiscalYear.StartDate } – { model.Report.FiscalYear.EndDate }</p>
						@statementStatus(model.Page.Messages, model.SetupHref, model.Report.ClassificationComplete)
					}
					<section class="current-overview-section" aria-labelledby="current-balances-heading">
						<h2 id="current-balances-heading">{ model.Page.Messages.CurrentBalancesHeading }</h2>
						<p>{ model.Page.Messages.CurrentBalancesHelp }</p>
						<form class="period-form" method="post" action={ model.FormAction }>
							<input type="hidden" name="expense_period" value={ model.Selected.StartDate + "/" + model.Selected.EndDate }/>
							<label>{ model.Page.Messages.CurrentOverviewDateLabel }<input type="date" name="as_of" value={ model.AsOf } required/></label>
							<button type="submit">{ model.Page.Messages.CurrentOverviewShow }</button>
						</form>
						if model.Report != nil {
							if len(model.Report.Balances) == 0 {
								<section class="empty-state"><p>{ model.Page.Messages.CurrentOverviewEmptyBalances }</p></section>
							} else {
								for _, commodity := range model.Report.Balances {
									@currentBalanceCommodity(model.Page.Messages, commodity)
								}
							}
						}
					</section>
					<section class="current-overview-section" aria-labelledby="current-expenses-heading">
						<h2 id="current-expenses-heading">{ model.Page.Messages.CurrentExpenseHeading }</h2>
						<p>{ model.Page.Messages.CurrentExpenseHelp }</p>
						<form class="period-form" method="post" action={ model.FormAction }>
							<input type="hidden" name="as_of" value={ model.AsOf }/>
							<label>{ model.Page.Messages.CurrentOverviewExpenseMonthLabel }<select name="expense_period">
								for _, option := range model.Periods {
									if option.Period == model.Selected {
										<option value={ option.Period.StartDate + "/" + option.Period.EndDate } selected>{ option.Label }</option>
									} else {
										<option value={ option.Period.StartDate + "/" + option.Period.EndDate }>{ option.Label }</option>
									}
								}
							</select></label>
							<button type="submit">{ model.Page.Messages.CurrentOverviewShowExpenses }</button>
						</form>
						if model.Report != nil {
							<p>{ model.Page.Messages.CurrentExpensePeriod }: { model.Report.ExpensePeriod.StartDate } – { model.Report.ExpensePeriod.EndDate }</p>
							if len(model.Report.Expenses) == 0 {
								<section class="empty-state"><p>{ model.Page.Messages.CurrentOverviewEmptyExpenses }</p></section>
							} else {
								for _, commodity := range model.Report.Expenses {
									@currentExpenseCommodity(model.Page.Messages, commodity)
								}
							}
						}
					</section>
				}
			</main>
		</body>
	</html>
}

templ currentBalanceCommodity(msg messages, commodity reporting.StatementCommoditySection) {
	<section class="commodity-section current-overview-commodity">
		<h3>{ msg.StatementCommodity }: { commodity.Commodity }</h3>
		<div class="current-summary-grid">
			for _, group := range currentBalanceSummaryGroups(commodity) {
				<article class="current-summary-card">
					<h4>{ reportingCategoryLabel(msg, group.Category) }</h4>
					<strong>{ statementAmount(group.Category, group.Total) }</strong>
					<span>{ msg.StatementActualSide }: { statementActualSide(msg, group.Total) }</span>
				</article>
			}
		</div>
		@statementTable(msg, commodity, "")
	</section>
}

templ currentExpenseCommodity(msg messages, commodity reporting.StatementCommoditySection) {
	<section class="commodity-section current-overview-commodity">
		<h3>{ msg.StatementCommodity }: { commodity.Commodity }</h3>
		<article class="current-summary-card expense-summary-card">
			<h4>{ msg.CurrentExpenseTotal }</h4>
			<strong>{ statementAmount(reporting.CategoryExpense, commodity.Total) }</strong>
			<span>{ msg.StatementActualSide }: { statementActualSide(msg, commodity.Total) }</span>
		</article>
		@statementTable(msg, commodity, "")
	</section>
}

templ statementPeriodForm(msg messages, action string, periods []trialBalancePeriodOption, selected reporting.Period, label string) {
	<form class="period-form" method="post" action={ action }>
		<label>{ label }<select name="period">
			for _, option := range periods {
				if option.Period == selected {
					<option value={ option.Period.StartDate + "/" + option.Period.EndDate } selected>{ option.Label }</option>
				} else {
					<option value={ option.Period.StartDate + "/" + option.Period.EndDate }>{ option.Label }</option>
				}
			}
		</select></label>
		<button type="submit">{ msg.StatementShow }</button>
	</form>
}

templ statementStatus(msg messages, setupHref string, complete bool) {
	if !complete {
		<section class="form-error" role="alert"><p>{ msg.StatementClassificationWarning } <a href={ setupHref }>{ msg.StatementSetupLink }</a></p></section>
	}
}

templ balanceSheetPage(model balanceSheetPageModel) {
	<!DOCTYPE html>
	<html lang={ model.Page.Locale.lang() }>
		@documentHead(model.Page.Messages.BalanceSheetTitle)
		<body>
			@siteHeader(model.Page)
			<main id="main-content" class="page detail-page statement-page">
				@reportNavigation(model.Page)
				<header class="page-heading"><div><p class="eyebrow">{ model.Page.Messages.BalanceSheetEyebrow }</p><h1>{ model.Page.Messages.BalanceSheetTitle }</h1></div></header>
				if !model.Configured {
					<section class="empty-state"><p>{ model.Page.Messages.StatementNotConfigured }</p><a href={ model.SetupHref }>{ model.Page.Messages.StatementSetupLink }</a></section>
				} else {
					if model.FormError != "" {
						<section class="form-error" role="alert"><h2>{ model.Page.Messages.FormErrorTitle }</h2><p>{ model.FormError }</p><a href={ model.SetupHref }>{ model.Page.Messages.StatementSetupLink }</a></section>
					}
					@statementPeriodForm(model.Page.Messages, model.FormAction, model.Periods, model.Selected, model.Page.Messages.StatementFiscalYearLabel)
					if model.Report != nil {
						<p>{ model.Page.Messages.StatementConfigurationRevision }: { model.Report.ConfigurationRevision } · { model.Page.Messages.BalanceSheetAsOf }: { model.Report.AsOf }</p>
						@statementStatus(model.Page.Messages, model.SetupHref, model.Report.ClassificationComplete)
						if len(model.Report.Commodities) == 0 {
							<section class="empty-state"><p>{ model.Page.Messages.StatementEmpty }</p></section>
						} else {
							for _, commodity := range model.Report.Commodities {
								@statementCommodity(model.Page.Messages, commodity, "")
							}
						}
					}
				}
			</main>
		</body>
	</html>
}

templ incomeStatementPage(model incomeStatementPageModel) {
	<!DOCTYPE html>
	<html lang={ model.Page.Locale.lang() }>
		@documentHead(model.Page.Messages.IncomeStatementTitle)
		<body>
			@siteHeader(model.Page)
			<main id="main-content" class="page detail-page statement-page">
				@reportNavigation(model.Page)
				<header class="page-heading"><div><p class="eyebrow">{ model.Page.Messages.IncomeStatementEyebrow }</p><h1>{ model.Page.Messages.IncomeStatementTitle }</h1></div></header>
				if !model.Configured {
					<section class="empty-state"><p>{ model.Page.Messages.StatementNotConfigured }</p><a href={ model.SetupHref }>{ model.Page.Messages.StatementSetupLink }</a></section>
				} else {
					if model.FormError != "" {
						<section class="form-error" role="alert"><h2>{ model.Page.Messages.FormErrorTitle }</h2><p>{ model.FormError }</p></section>
					}
					@statementPeriodForm(model.Page.Messages, model.FormAction, model.Periods, model.Selected, model.Page.Messages.StatementMonthlyPeriodLabel)
					if model.Report != nil {
						<p>{ model.Page.Messages.StatementConfigurationRevision }: { model.Report.ConfigurationRevision } · { model.Report.Period.StartDate } – { model.Report.Period.EndDate }</p>
						@statementStatus(model.Page.Messages, model.SetupHref, model.Report.ClassificationComplete)
						if len(model.Report.Commodities) == 0 {
							<section class="empty-state"><p>{ model.Page.Messages.StatementEmpty }</p></section>
						} else {
							for _, commodity := range model.Report.Commodities {
								@statementCommodity(model.Page.Messages, commodity.StatementCommoditySection, statementAmount(reporting.CategoryRevenue, commodity.NetIncome))
							}
						}
					}
				}
			</main>
		</body>
	</html>
}

templ statementCommodity(msg messages, commodity reporting.StatementCommoditySection, netIncome string) {
	<section class="commodity-section statement-commodity">
		<h2>{ msg.StatementCommodity }: { commodity.Commodity }</h2>
		@statementTable(msg, commodity, netIncome)
	</section>
}

templ statementTable(msg messages, commodity reporting.StatementCommoditySection, netIncome string) {
	<div class="table-wrap"><table class="statement-table">
			<thead><tr><th>{ msg.AccountColumn }</th><th>{ msg.StatementAmount }</th><th>{ msg.StatementActualSide }</th></tr></thead>
			<tbody>
				for _, group := range commodity.Groups {
					<tr class="category-row"><th>{ reportingCategoryLabel(msg, group.Category) }</th><td>{ statementAmount(group.Category, group.Total) }</td><td>{ statementActualSide(msg, group.Total) }</td></tr>
					for _, account := range group.Accounts {
						<tr><th>{ statementAccountLabel(account) }
							for _, warning := range account.Warnings {
								<span class="warning-code">{ warning.Code }
									if warning.Side != "" {
										<span> · { warningSideLabel(msg, warning.Side) }</span>
									}
								</span>
							}
						</th><td>{ statementAmount(group.Category, account.Subtotal) }</td><td>{ statementActualSide(msg, account.Subtotal) }</td></tr>
						if hasDistinctStatementDirect(account) {
							<tr class="direct-detail-row"><th>{ msg.StatementDirect }</th><td>{ statementAmount(group.Category, account.Direct) }</td><td>{ statementActualSide(msg, account.Direct) }</td></tr>
						}
					}
				}
			</tbody>
			if netIncome != "" {
				<tfoot><tr><th>{ msg.IncomeStatementNetIncome }</th><td>{ netIncome }</td><td></td></tr></tfoot>
			}
	</table></div>
}

templ balanceTrendPage(model balanceTrendPageModel) {
	<!DOCTYPE html>
	<html lang={ model.Page.Locale.lang() }>
		@documentHead(model.Page.Messages.BalanceTrendTitle)
		<body>
			@siteHeader(model.Page)
			<main id="main-content" class="page detail-page statement-page">
				@reportNavigation(model.Page)
				<header class="page-heading"><div><p class="eyebrow">{ model.Page.Messages.BalanceTrendEyebrow }</p><h1>{ model.Page.Messages.BalanceTrendTitle }</h1></div></header>
				<p>{ model.Page.Messages.BalanceTrendHelp }</p>
				if !model.Configured {
					<section class="empty-state"><p>{ model.Page.Messages.StatementNotConfigured }</p><a href={ model.SetupHref }>{ model.Page.Messages.StatementSetupLink }</a></section>
				} else {
					if model.FormError != "" {
						<section class="form-error" role="alert"><h2>{ model.Page.Messages.FormErrorTitle }</h2><p>{ model.FormError }</p><a href={ model.SetupHref }>{ model.Page.Messages.StatementSetupLink }</a></section>
					}
					@statementPeriodForm(model.Page.Messages, model.FormAction, model.Periods, model.Selected, model.Page.Messages.StatementFiscalYearLabel)
					if model.Report != nil {
						<p>{ model.Page.Messages.StatementConfigurationRevision }: { model.Report.ConfigurationRevision } · { model.Report.FiscalYear.StartDate } – { model.Report.FiscalYear.EndDate }</p>
						@statementStatus(model.Page.Messages, model.SetupHref, model.Report.ClassificationComplete)
						<div class="balance-trend-grid">
							for _, point := range model.Report.Points {
								<section class="balance-trend-point">
									<h2>{ model.Page.Messages.MonthlyPeriodLabel(point.Period.Month, point.Period.StartDate, point.Period.EndDate) }</h2>
									for _, commodity := range point.Commodities {
										@trendCommodity(model.Page.Messages, commodity)
									}
								</section>
							}
						</div>
					}
				}
			</main>
		</body>
	</html>
}

templ trendCommodity(msg messages, commodity reporting.StatementCommoditySection) {
	<section class="trend-commodity">
		<h3>{ msg.StatementCommodity }: { commodity.Commodity }</h3>
		for _, group := range commodity.Groups {
			<h4>{ reportingCategoryLabel(msg, group.Category) } <span>{ statementAmount(group.Category, group.Total) }</span></h4>
			<ul class="trend-account-list">
				for _, account := range group.Accounts {
					<li><span>{ statementAccountLabel(account) }</span><strong>{ statementAmount(group.Category, account.Subtotal) }</strong>
						for _, warning := range account.Warnings {
							<small class="warning-code">{ warning.Code }
								if warning.Side != "" {
									<span> · { warningSideLabel(msg, warning.Side) }</span>
								}
							</small>
						}
					</li>
				}
			</ul>
		}
	</section>
}

templ trialBalanceCommodity(msg messages, commodity reporting.CommoditySection) {
	<section class="commodity-section">
		<h2>{ msg.TrialBalanceCommodity }: { commodity.Commodity }</h2>
		<p class="table-help">{ msg.TrialBalanceTableHelp }</p>
		<div class="table-wrap trial-balance-desktop"><table class="trial-balance-table">
			<thead><tr><th>{ msg.AccountColumn }</th>@trialBalanceColumnHeadings(msg)</tr></thead>
			<tbody>
				for _, group := range commodity.Groups {
					<tr class="category-row"><th>{ reportingCategoryLabel(msg, group.Category) }</th>@trialBalanceAmountCells(group.Total)</tr>
					for _, account := range group.Accounts {
						<tr><th>{ accountLabel(account) }
							for _, warning := range account.Warnings {
								<span class="warning-code">{ warning.Code }</span>
							}
						</th>@trialBalanceAmountCells(account.Subtotal)</tr>
						if hasDistinctDirectAmounts(account) {
							<tr class="direct-detail-row"><th><span>{ msg.TrialBalanceDirect }</span></th>@trialBalanceAmountCells(account.Direct)</tr>
						}
					}
				}
			</tbody>
			<tfoot><tr><th>{ commodity.Commodity }</th>@trialBalanceAmountCells(commodity.Total)</tr></tfoot>
		</table></div>
		<div class="trial-balance-mobile">
			for _, group := range commodity.Groups {
				<section class="trial-balance-mobile-group">
					<h3>{ reportingCategoryLabel(msg, group.Category) }</h3>
					<div class="trial-balance-mobile-total">
						<span class="mobile-amount-kind">{ msg.TrialBalanceSubtotal }</span>
						@trialBalanceMobileAmounts(msg, group.Total)
					</div>
					for _, account := range group.Accounts {
						<article class="trial-balance-account-card">
							<h4>{ accountLabel(account) }</h4>
							for _, warning := range account.Warnings {
								<span class="warning-code">{ warning.Code }</span>
							}
							@trialBalanceMobileAmounts(msg, account.Subtotal)
							if hasDistinctDirectAmounts(account) {
								<details class="direct-amount-details">
									<summary>{ msg.TrialBalanceDirect }</summary>
									@trialBalanceMobileAmounts(msg, account.Direct)
								</details>
							}
						</article>
					}
				</section>
			}
			<section class="trial-balance-mobile-grand-total">
				<h3>{ commodity.Commodity }</h3>
				@trialBalanceMobileAmounts(msg, commodity.Total)
			</section>
		</div>
	</section>
}

templ trialBalanceColumnHeadings(msg messages) {
	<th>{ msg.TrialBalanceOpeningDebit }</th><th>{ msg.TrialBalanceOpeningCredit }</th><th>{ msg.TrialBalanceDebitTurnover }</th><th>{ msg.TrialBalanceCreditTurnover }</th><th>{ msg.TrialBalanceClosingDebit }</th><th>{ msg.TrialBalanceClosingCredit }</th>
}

templ trialBalanceAmountCells(amounts reporting.Amounts) {
	<td>{ amounts.Opening.Debit }</td><td>{ amounts.Opening.Credit }</td><td>{ amounts.DebitTurnover }</td><td>{ amounts.CreditTurnover }</td><td>{ amounts.Closing.Debit }</td><td>{ amounts.Closing.Credit }</td>
}

templ trialBalanceMobileAmounts(msg messages, amounts reporting.Amounts) {
	<dl class="mobile-amount-grid">
		<div><dt>{ msg.TrialBalanceOpeningDebit }</dt><dd>{ amounts.Opening.Debit }</dd></div>
		<div><dt>{ msg.TrialBalanceOpeningCredit }</dt><dd>{ amounts.Opening.Credit }</dd></div>
		<div><dt>{ msg.TrialBalanceDebitTurnover }</dt><dd>{ amounts.DebitTurnover }</dd></div>
		<div><dt>{ msg.TrialBalanceCreditTurnover }</dt><dd>{ amounts.CreditTurnover }</dd></div>
		<div><dt>{ msg.TrialBalanceClosingDebit }</dt><dd>{ amounts.Closing.Debit }</dd></div>
		<div><dt>{ msg.TrialBalanceClosingCredit }</dt><dd>{ amounts.Closing.Credit }</dd></div>
	</dl>
}

templ searchForm(model indexPageModel) {
	<form class="search-panel" method="post" action={ model.Search.Action } aria-label={ model.Page.Messages.SearchFormLabel } hx-post={ model.Search.Action } hx-target="#entry-results" hx-swap="outerHTML">
		<h2>{ model.Page.Messages.SearchHeading }</h2>
		<div class="search-grid">
			<label>{ model.Page.Messages.DateFromLabel }<input type="date" name="date_from" value={ model.Search.Filter.DateFrom }/></label>
			<label>{ model.Page.Messages.DateToLabel }<input type="date" name="date_to" value={ model.Search.Filter.DateTo }/></label>
			<label>{ model.Page.Messages.AccountFilterLabel }<input type="search" name="account" value={ model.Search.Filter.Account }/></label>
			<label>{ model.Page.Messages.DescriptionFilterLabel }<input type="search" name="description" value={ model.Search.Filter.Description }/></label>
			<label>{ model.Page.Messages.ImportStatusFilterLabel }
				<select name="status">
					<option value="">{ model.Page.Messages.AllImportStatuses }</option>
					if model.Search.Filter.Status == "success" {
						<option value="success" selected>{ model.Page.Messages.ImportStatusSuccess }</option>
					} else {
						<option value="success">{ model.Page.Messages.ImportStatusSuccess }</option>
					}
					if model.Search.Filter.Status == "warning" {
						<option value="warning" selected>{ model.Page.Messages.ImportStatusWarning }</option>
					} else {
						<option value="warning">{ model.Page.Messages.ImportStatusWarning }</option>
					}
				</select>
			</label>
			<label>{ model.Page.Messages.WorkflowFilterLabel }
				<select name="workflow_status">
					<option value="">{ model.Page.Messages.AllWorkflowStatuses }</option>
					if model.Search.Filter.WorkflowStatus == "unapproved" {
						<option value="unapproved" selected>{ model.Page.Messages.WorkflowStatusUnapproved }</option>
					} else {
						<option value="unapproved">{ model.Page.Messages.WorkflowStatusUnapproved }</option>
					}
					if model.Search.Filter.WorkflowStatus == "invalid" {
						<option value="invalid" selected>{ model.Page.Messages.WorkflowStatusInvalid }</option>
					} else {
						<option value="invalid">{ model.Page.Messages.WorkflowStatusInvalid }</option>
					}
					if model.Search.Filter.WorkflowStatus == "approved" {
						<option value="approved" selected>{ model.Page.Messages.WorkflowStatusApproved }</option>
					} else {
						<option value="approved">{ model.Page.Messages.WorkflowStatusApproved }</option>
					}
				</select>
			</label>
			<label>{ model.Page.Messages.SourceNamespaceLabel }<input type="search" name="source_namespace" value={ model.Search.Filter.SourceNamespace }/></label>
			<label>{ model.Page.Messages.SourceDisplayLabel }<input type="search" name="source_display" value={ model.Search.Filter.SourceDisplay }/></label>
		</div>
		<div class="form-actions">
			<button type="submit">{ model.Page.Messages.SearchSubmit }</button>
			<a href={ model.Search.ResetHref }>{ model.Page.Messages.ClearSearch }</a>
		</div>
	</form>
}

templ entryResults(model indexPageModel) {
	<section id="entry-results" class="entry-results" aria-label={ model.Page.Messages.SearchResultsLabel } aria-live="polite">
		<header class="results-heading">
			<h2>{ model.Page.Messages.SearchResultsLabel }</h2>
			<p>{ model.Page.Messages.EntriesShown(len(model.Entries)) }</p>
		</header>
		<div class="export-actions" aria-label={ model.Page.Messages.ExportHeading }>
			<form method="post" action={ model.Export.TacklerAction }>
				@exportHiddenFields(model.Export)
				<button type="submit">{ model.Page.Messages.ExportTackler }</button>
			</form>
			<form method="post" action={ model.Export.JSONAction }>
				@exportHiddenFields(model.Export)
				<button type="submit">{ model.Page.Messages.ExportJSON }</button>
			</form>
		</div>
		if len(model.Entries) == 0 {
			<section class="empty-state" aria-labelledby="empty-heading">
				if model.SearchApplied {
					<h2 id="empty-heading">{ model.Page.Messages.NoMatchingEntriesTitle }</h2>
					<p>{ model.Page.Messages.NoMatchingEntriesMessage }</p>
				} else {
					<h2 id="empty-heading">{ model.Page.Messages.EmptyEntriesTitle }</h2>
					<p>{ model.Page.Messages.EmptyEntriesMessage }</p>
				}
			</section>
		} else {
			<div class="entry-list">
				for _, entry := range model.Entries {
					<article class="entry-card">
						<div>
							<p class="entry-date">{ entry.OccurredAt }</p>
							<h2><a href={ entry.Href }>{ entry.Description }</a></h2>
							<p class="source">{ entry.Source.Namespace }: { entry.Source.Display }</p>
						</div>
						<dl class="status-list">
							<div><dt>{ model.Page.Messages.ImportStatusLabel }</dt><dd>{ entry.Status }</dd></div>
							<div><dt>{ model.Page.Messages.WorkflowStatusLabel }</dt><dd>{ entry.WorkflowStatus }</dd></div>
							<div><dt>{ model.Page.Messages.RevisionLabel }</dt><dd>{ entry.CurrentRevision }</dd></div>
						</dl>
					</article>
				}
			</div>
		}
		if model.NextCursor != "" {
			<form class="pagination-form" method="post" action={ model.Search.Action } hx-post={ model.Search.Action } hx-target="#entry-results" hx-swap="outerHTML">
				@searchHiddenFields(model.Search)
				<input type="hidden" name="cursor" value={ model.NextCursor }/>
				<button type="submit">{ model.Page.Messages.NextPage }</button>
			</form>
		}
	</section>
}

templ searchHiddenFields(search searchFormModel) {
	<input type="hidden" name="date_from" value={ search.Filter.DateFrom }/>
	<input type="hidden" name="date_to" value={ search.Filter.DateTo }/>
	<input type="hidden" name="account" value={ search.Filter.Account }/>
	<input type="hidden" name="description" value={ search.Filter.Description }/>
	<input type="hidden" name="status" value={ search.Filter.Status }/>
	<input type="hidden" name="workflow_status" value={ search.Filter.WorkflowStatus }/>
	<input type="hidden" name="source_namespace" value={ search.Filter.SourceNamespace }/>
	<input type="hidden" name="source_display" value={ search.Filter.SourceDisplay }/>
}

templ exportHiddenFields(export exportFormModel) {
	<input type="hidden" name="date_from" value={ export.Filter.DateFrom }/>
	<input type="hidden" name="date_to" value={ export.Filter.DateTo }/>
	<input type="hidden" name="account" value={ export.Filter.Account }/>
	<input type="hidden" name="description" value={ export.Filter.Description }/>
	<input type="hidden" name="status" value={ export.Filter.Status }/>
	<input type="hidden" name="workflow_status" value={ export.Filter.WorkflowStatus }/>
	<input type="hidden" name="source_namespace" value={ export.Filter.SourceNamespace }/>
	<input type="hidden" name="source_display" value={ export.Filter.SourceDisplay }/>
}

templ entryPage(model entryPageModel) {
	<!DOCTYPE html>
	<html lang={ model.Page.Locale.lang() }>
		@documentHead(model.Current.Description)
		<body>
			@siteHeader(model.Page)
			<main id="main-content" class="page detail-page">
				<a class="back-link" href={ model.Page.HomeHref }>← { model.Page.Messages.BackToEntries }</a>
				<header class="page-heading">
					<div><p class="eyebrow">{ model.Page.Messages.CurrentCandidateEyebrow(model.Current.Revision) }</p><h1>{ model.Current.Description }</h1></div>
					<p class="status-badge">{ model.Detail.Status }</p>
				</header>
				<p>{ model.Current.OccurredAt }</p>
				<section aria-labelledby="source-heading">
					<h2 id="source-heading">{ model.Page.Messages.SourceHeading }</h2>
					<p>{ model.Detail.Source.Namespace }: { model.Detail.Source.Display }</p>
					<p>{ model.Page.Messages.RunLabel } <a href={ model.RunHref }>{ model.Detail.RunIdentity }</a> / { model.Page.Messages.RecordLabel } { model.Detail.RecordIndex }</p>
				</section>
				<section aria-labelledby="candidate-heading">
					<h2 id="candidate-heading">{ model.Page.Messages.CurrentCandidateHeading }</h2>
					@postingTable(model.Page.Messages, model.Current.Postings)
					@commentList(model.Current.Comments)
				</section>
				@entryFormError(model)
				<section aria-labelledby="edit-heading">
					<h2 id="edit-heading">{ model.Page.Messages.EditCandidateHeading }</h2>
					<form class="revision-form" method="post" action={ model.RevisionForm.Action } aria-label={ model.Page.Messages.EditCandidateFormLabel }>
						<input type="hidden" name="base_revision" value={ formInt(model.RevisionForm.BaseRevision) }/>
						<label class="stacked-field">{ model.Page.Messages.EntryTextLabel }
							<textarea class="entry-textarea" name="entry" rows="10" spellcheck="false" data-tab-inserts-spaces="true" required>{ model.RevisionForm.EntryText }</textarea>
							<span class="field-help">{ model.Page.Messages.EntryTextHelp }</span>
						</label>
						<div class="form-actions"><button type="submit">{ model.Page.Messages.SaveRevision }</button></div>
					</form>
				</section>
				<section aria-labelledby="approval-heading">
					<h2 id="approval-heading">{ model.Page.Messages.ApproveCandidateHeading }</h2>
					if model.ApprovalForm.CanApprove {
						<form method="post" action={ model.ApprovalForm.Action } aria-label={ model.Page.Messages.ApproveCandidateFormLabel }>
							<input type="hidden" name="revision" value={ formInt(model.ApprovalForm.Revision) }/>
							<button type="submit">{ model.Page.Messages.ApproveRevision }</button>
						</form>
					} else if model.Current.Approved {
						<p class="muted">{ model.Page.Messages.AlreadyApproved }</p>
					} else {
						<p class="muted">{ model.Page.Messages.CannotApproveInvalid }</p>
					}
				</section>
				<section aria-labelledby="original-heading">
					<h2 id="original-heading">{ model.Page.Messages.OriginalSnapshotHeading }</h2>
					<p>{ model.Detail.OccurredAt } · { model.Detail.Description }</p>
					@postingTable(model.Page.Messages, model.Detail.Postings)
					@commentList(model.Detail.Comments)
				</section>
				<section aria-labelledby="import-diagnostic-heading">
					<h2 id="import-diagnostic-heading">{ model.Page.Messages.ImportDiagnostics }</h2>
					if len(model.Detail.Diagnostics) == 0 {
						<p class="muted">{ model.Page.Messages.None }</p>
					} else {
						@diagnostics(model.Page.Messages, model.Detail.Diagnostics)
					}
				</section>
				<section aria-labelledby="history-heading"><h2 id="history-heading">{ model.Page.Messages.HistoryHeading }</h2>
					<p>{ model.Page.Messages.CurrentRevisionLabel }: { model.Detail.CurrentRevision }</p>
					if model.Detail.CurrentApproval != nil {
						<p>{ model.Page.Messages.CurrentApprovalLabel }: { model.Page.Messages.CurrentApprovalSummary(model.Detail.CurrentApproval.Revision, model.Detail.CurrentApproval.ApprovedAt) }</p>
					} else {
						<p>{ model.Page.Messages.CurrentApprovalLabel }: { model.Page.Messages.Unapproved }</p>
					}
					for _, revision := range model.Detail.Revisions {
						<article class="history-card">
							<h3>{ model.Page.Messages.RevisionHeader(revision.Revision) }</h3>
							<p>{ model.Page.Messages.BaseRevisionSummary(revision.BaseRevision, revision.CreatedAt, revision.Valid) }</p>
							<p>{ revision.OccurredAt } · { revision.Description }</p>
							@postingTable(model.Page.Messages, revision.Postings)
							@commentList(revision.Comments)
							@diagnostics(model.Page.Messages, revision.Diagnostics)
						</article>
					}
					if len(model.Detail.Approvals) > 0 {
						<h3>{ model.Page.Messages.ApprovalHistory }</h3>
						<ul>
							for _, approval := range model.Detail.Approvals {
								<li>{ model.Page.Messages.ApprovalSummary(approval.Sequence, approval.Revision, approval.ApprovedAt) }</li>
							}
						</ul>
					}
				</section>
			</main>
		</body>
	</html>
}

templ runPage(model runPageModel) {
	<!DOCTYPE html>
	<html lang={ model.Page.Locale.lang() }>
		@documentHead(model.Page.Messages.RunTitle)
		<body>
			@siteHeader(model.Page)
			<main id="main-content" class="page detail-page">
				<a class="back-link" href={ model.Page.HomeHref }>← { model.Page.Messages.BackToEntries }</a>
				<header class="page-heading"><div><p class="eyebrow">{ model.Page.Messages.RunEyebrow }</p><h1>{ model.Page.Messages.RunTitle }</h1></div>
					if model.Detail.HasErrors {
						<p class="status-badge status-error">{ model.Page.Messages.NeedsReview }</p>
					} else {
						<p class="status-badge">{ model.Page.Messages.Complete }</p>
					}
				</header>
				<p class="identifier">{ model.Detail.RunIdentity }</p>
				<dl class="metadata-list">
					<div><dt>{ model.Page.Messages.InputDigestLabel }</dt><dd>{ model.Detail.InputDigest }</dd></div>
					<div><dt>{ model.Page.Messages.PreStateGeneration }</dt><dd>{ model.Detail.PreStateGeneration }</dd></div>
				</dl>
				<section aria-labelledby="outcome-heading"><h2 id="outcome-heading">{ model.Page.Messages.OutcomesHeading }</h2><div class="entry-list">
					for _, outcome := range model.Outcomes {
						<article class="entry-card"><div><p>{ model.Page.Messages.RecordStatusSummary(outcome.Detail.RecordIndex, outcome.Detail.Status) }</p><p>{ outcome.Detail.Source.Namespace }: { outcome.Detail.Source.Display }</p>
							<p>{ model.Page.Messages.IdentityLabel }: { model.Page.Messages.IdentitySummary(outcome.Detail.Identity.Kind, outcome.Detail.Identity.AlgorithmVersion, outcome.Detail.Identity.Digest) }</p>
							if outcome.EntryHref != "" {
								<a href={ outcome.EntryHref }>{ model.Page.Messages.ViewEntry }</a>
							}
						</div>@diagnostics(model.Page.Messages, outcome.Detail.Diagnostics)</article>
					}
				</div></section>
			</main>
		</body>
	</html>
}

templ postingTable(msg messages, items []webapp.PostingDetail) {
	<div class="table-wrap"><table><thead><tr><th scope="col">{ msg.AccountColumn }</th><th scope="col">{ msg.AmountColumn }</th><th scope="col">{ msg.CommentColumn }</th></tr></thead><tbody>
		for _, posting := range items {
			<tr><td>{ posting.Account }</td><td>
				if posting.Amount != nil {
					<span>{ *posting.Amount } { posting.Commodity }
						if posting.TotalPrice != nil {
							= { posting.TotalPrice.Amount } { posting.TotalPrice.Commodity }
						}
					</span>
				} else {
					<span class="muted">{ msg.OmittedAmount }</span>
				}
			</td><td>{ posting.Comment }</td></tr>
		}
	</tbody></table></div>
}

templ commentList(items []string) {
	if len(items) > 0 {
		<ul>
			for _, comment := range items {
				<li>{ comment }</li>
			}
		</ul>
	}
}

templ entryFormError(model entryPageModel) {
	if model.FormError != "" {
		<section class="form-error" aria-labelledby="form-error-heading" role="alert">
			<h2 id="form-error-heading">{ model.Page.Messages.FormErrorTitle }</h2>
			<p>{ model.FormError }</p>
		</section>
	}
}

templ diagnostics(msg messages, items []webapp.DiagnosticDetail) {
	if len(items) > 0 {
		<section class="diagnostics" aria-label={ msg.DiagnosticsLabel }><ul>
			for _, item := range items {
				<li><strong>{ item.Severity }</strong> · { item.Code }: { item.Message }</li>
			}
		</ul></section>
	}
}

templ errorPage(model errorPageModel) {
	<!DOCTYPE html>
	<html lang={ model.Page.Locale.lang() }>
		@documentHead(model.Title)
		<body>@siteHeader(model.Page)<main id="main-content" class="page error-page"><p class="eyebrow">{ model.Page.Messages.ErrorLabel } { model.Status }</p><h1>{ model.Title }</h1><p>{ model.Message }</p>
			if model.Detail != "" {
				<section class="development-error" aria-labelledby="development-error-heading"><h2 id="development-error-heading">{ model.Page.Messages.DevelopmentErrorDetail }</h2><pre>{ model.Detail }</pre></section>
			}
			<a href={ model.Page.HomeHref }>{ model.Page.Messages.BackToEntries }</a>
		</main></body>
	</html>
}
